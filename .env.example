NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ultimate_tunnel_admin
# Exact browser origin; use the frontend's HTTPS origin in production.
FRONTEND_ORIGIN=http://localhost:5173
# Set when building the production frontend; leave empty to use the Vite dev proxy.
VITE_API_BASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
# Enable only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
