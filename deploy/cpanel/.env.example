NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=your_cpanel_mysql_database
FRONTEND_ORIGIN=https://admin.example.com
SESSION_COOKIE_SECURE=true
TRUST_PROXY=false
